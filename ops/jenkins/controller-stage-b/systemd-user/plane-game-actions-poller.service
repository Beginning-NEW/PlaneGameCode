[Unit]
Description=PlaneGame bounded public Actions poller (disabled package)
After=network-online.target
Wants=network-online.target
ConditionPathIsRegular=%h/.local/state/plane-game-poller/jenkins-api-token
ConditionPathIsRegular=%h/.local/state/plane-game-poller/journal.ndjson
ConditionPathIsRegular=%h/.local/state/plane-game-poller/snapshot.json
ConditionPathIsRegular=%h/.local/state/plane-game-poller/.shared.lock

[Service]
Type=oneshot
WorkingDirectory=%h/plane-game-cd
RuntimeDirectory=plane-game-poller
RuntimeDirectoryMode=0700
UMask=0077
Environment=CD_TRIGGER_MODE=disabled
Environment=PLANE_POLLER_STATE_DIR=%h/.local/state/plane-game-poller
Environment=PLANE_POLLER_JENKINS_CREDENTIAL_FILE=%h/.local/state/plane-game-poller/jenkins-api-token
ExecStart=/usr/bin/flock --no-fork --nonblock %h/.local/state/plane-game-poller/.shared.lock /usr/bin/node %h/plane-game-cd/ops/jenkins/private-actions-poller.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectProc=invisible
ReadWritePaths=%h/.local/state/plane-game-poller
