{
  "schema": 1,
  "valuesAreMetadataOnly": true,
  "bootstrap": {
    "principal": "plane-admin",
    "secretSource": "/run/secrets/PLANE_ADMIN_BOOTSTRAP_BCRYPT",
    "hostFile": "admin-bootstrap-bcrypt",
    "format": "Jenkins #jbcrypt hash",
    "lifecycle": "one restart; remove after readiness; a different hash re-applies once for rotation"
  },
  "credentials": [
    {
      "id": "plane-github-scm-read",
      "kind": "usernamePassword",
      "scope": "GLOBAL",
      "hostFiles": ["github-scm-username", "github-scm-password"],
      "secretSources": [
        "/run/secrets/PLANE_GITHUB_SCM_USERNAME",
        "/run/secrets/PLANE_GITHUB_SCM_PASSWORD"
      ],
      "minimumExternalAccess": ["repository:Contents:read"],
      "consumer": "plane-game/main-cd SCM checkout"
    },
    {
      "id": "plane-github-actions-read",
      "kind": "secretText",
      "scope": "GLOBAL",
      "hostFiles": ["github-actions-token"],
      "secretSources": ["/run/secrets/PLANE_GITHUB_ACTIONS_TOKEN"],
      "minimumExternalAccess": ["repository:Actions:read", "repository:Contents:read"],
      "consumer": "same-SHA Actions run, artifact, and protected-main verification"
    },
    {
      "id": "plane-ghcr-pull",
      "kind": "usernamePassword",
      "scope": "GLOBAL",
      "hostFiles": ["ghcr-username", "ghcr-token"],
      "secretSources": [
        "/run/secrets/PLANE_GHCR_USERNAME",
        "/run/secrets/PLANE_GHCR_TOKEN"
      ],
      "minimumExternalAccess": ["GHCR:read:packages"],
      "consumer": "digest-pinned release pull"
    },
    {
      "id": "plane-game-agent-ssh",
      "kind": "basicSSHUserPrivateKey",
      "scope": "SYSTEM",
      "hostFiles": ["agent-private-key"],
      "secretSources": ["/run/secrets/PLANE_AGENT_PRIVATE_KEY"],
      "minimumExternalAccess": ["plane-preflight SSH principal"],
      "consumer": "plane-game-cd-rootless agent launcher"
    }
  ],
  "gateway": {
    "principal": "plane-webhook-gateway",
    "globalPermissions": ["Overall/Read"],
    "job": "plane-game/main-cd",
    "jobPermissions": ["Job/Read", "Job/Build"],
    "forbiddenPermissions": ["Overall/Administer", "Overall/RunScripts", "Credentials/*", "Job/Configure"],
    "apiTokenHostFile": "~/.config/plane-game/credentials/jenkins-api-token",
    "hmacHostFile": "~/.config/plane-game/credentials/webhook-secret"
  }
}
