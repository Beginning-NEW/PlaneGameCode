# Dedicated virtual host only. Fill the two certificate markers after a
# read-only server audit and issuance of this subdomain's certificate. The
# application and webhook gateway ports are versioned loopback-only contracts.
# Never enable this template with unresolved markers.
server {
    listen 80;
    server_name plane-demo.emotionstock.com;
    access_log /var/log/nginx/plane-demo.access.log;
    error_log /var/log/nginx/plane-demo.error.log warn;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name plane-demo.emotionstock.com;
    ssl_certificate __PLANE_FULLCHAIN_PATH__;
    ssl_certificate_key __PLANE_PRIVKEY_PATH__;
    access_log /var/log/nginx/plane-demo.access.log;
    error_log /var/log/nginx/plane-demo.error.log warn;

    location = /github/workflow-run {
        limit_except POST {
            deny all;
        }

        proxy_pass http://127.0.0.1:9080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-GitHub-Delivery $http_x_github_delivery;
        proxy_set_header X-GitHub-Event $http_x_github_event;
        proxy_set_header X-Hub-Signature-256 $http_x_hub_signature_256;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
